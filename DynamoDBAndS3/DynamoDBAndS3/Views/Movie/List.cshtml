@model List<Movie>

<h1>List of Uploaded Movies</h1>

<a href="/Movie/UploadMovie">Upload a movie</a>
@if (Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Movie Id</th>
                <th>Name</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Movie movie in Model)
            {
                <tr>
                    <td>@movie.Id</td>
                    <td>@movie.Name</td>
                    <td>
                        <form method="post" id="rateForm-@movie.Id" action="/Movie/Ratings">
                            <input type="hidden" name="movieName" value="@movie.Name" />
                            <input type="hidden" name="movieId" value="@movie.Id" />
                            <button class="btn btn-primary" type="submit">Ratings/Comments</button>
                        </form>
                    </td>
                    <td><a class="btn btn-primary" href="https://navyafarhanalab3bucket.s3.us-east-1.amazonaws.com/@movie.File.Key">Download Movie</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No movies have been uploaded yet.</p>
}