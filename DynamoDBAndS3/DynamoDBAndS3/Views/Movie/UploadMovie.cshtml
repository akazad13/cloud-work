
<h1>Upload A Movie</h1>


<form method="post" action="UploadMovieToAWS" enctype="multipart/form-data">
    <div class="form-group">
        <label>Name of movie:</label> 
        <input class="form-control" type="text" name="movieName" />
    </div>

    
    <div class="form-group">
        <label>File:</label> 
        <input class="form-control" type="file" name="movieFile" />
    </div>

    <button class="btn btn-primary" type="submit">Upload</button>
</form>
